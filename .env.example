# Скопируйте в .env.local для локальной разработки.
# На Vercel эти же переменные добавляются в Settings → Environment Variables.
#
# Оба значения лежат в Supabase → Project Settings → API.
# Ключ anon публичный — его можно держать во фронтенде.
# Ключ service_role сюда вставлять НЕЛЬЗЯ.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
